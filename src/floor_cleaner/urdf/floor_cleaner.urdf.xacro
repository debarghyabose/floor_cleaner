<?xml version="1.0"?>
<!--
  Floor-cleaner robot description (differential drive).

  Frame layout (all distances in metres):

      base_link        origin on the FLOOR, midway between the two drive wheels.
                       Its parent (odom) is published by the diff drive plugin in
                       simulation, or by your motor-controller node on the real robot.
      ├── base_footprint   same point as base_link (kept for tools that expect it)
      ├── chassis          the rectangular body
      │   ├── front_caster
      │   └── rear_caster
      ├── left_wheel / right_wheel
      └── laser            2D LiDAR, 0.19 m above the floor

  Xacro argument:
      use_sim:=true   (default) adds the Gazebo plugins (diff drive, joint states, LiDAR sensor)
      use_sim:=false  pure description for the real robot
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="floor_cleaner">

  <xacro:arg name="use_sim" default="true"/>

  <!-- ===================== Dimensions ===================== -->
  <xacro:property name="chassis_length"   value="0.45"/>
  <xacro:property name="chassis_width"    value="0.35"/>
  <xacro:property name="chassis_height"   value="0.15"/>
  <xacro:property name="chassis_mass"     value="4.0"/>
  <xacro:property name="ground_clearance" value="0.02"/>

  <xacro:property name="wheel_radius"     value="0.075"/>
  <xacro:property name="wheel_width"      value="0.04"/>
  <xacro:property name="wheel_mass"       value="0.5"/>
  <xacro:property name="wheel_separation" value="0.30"/>

  <!-- Casters are 1 mm shorter than the drive wheels so the drive wheels
       always keep firm contact with the floor. -->
  <xacro:property name="caster_radius"    value="0.024"/>
  <xacro:property name="caster_mass"      value="0.1"/>
  <xacro:property name="caster_x_offset"  value="0.17"/>

  <xacro:include filename="$(find floor_cleaner)/urdf/materials.xacro"/>
  <xacro:include filename="$(find floor_cleaner)/urdf/inertial_macros.xacro"/>

  <!-- ===================== base_link ===================== -->
  <!-- Deliberately empty (no inertia): KDL/robot_state_publisher does not
       like an inertia on the root link. Gazebo merges the chassis mass into it. -->
  <link name="base_link"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="base_footprint"/>

  <!-- ===================== Chassis ===================== -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="chassis">
    <visual>
      <origin xyz="0 0 ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="cleaner_blue"/>
    </visual>
    <!-- white "bumper" strip on the front so you can tell front from back -->
    <visual>
      <origin xyz="${chassis_length/2 + 0.005} 0 ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 ${chassis_width - 0.02} ${chassis_height * 0.6}"/>
      </geometry>
      <material name="cleaner_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
      <origin xyz="0 0 ${ground_clearance + chassis_height/2}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- ===================== Drive wheels ===================== -->
  <!-- A wheel is a cylinder rotated so that its axis points sideways (Y).
       Both joints are oriented so that a POSITIVE joint velocity drives
       the robot FORWARD, which is what the diff drive plugin expects. -->
  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${y_reflect * wheel_separation/2} ${wheel_radius}"
              rpy="${-y_reflect * pi/2} 0 0"/>
      <axis xyz="0 0 ${y_reflect}"/>
    </joint>

    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="cleaner_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <gazebo reference="${prefix}_wheel">
      <material>Gazebo/FlatBlack</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  y_reflect="1"/>
  <xacro:drive_wheel prefix="right" y_reflect="-1"/>

  <!-- ===================== Casters (frictionless spheres) ===================== -->
  <xacro:macro name="caster" params="prefix x">
    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="chassis"/>
      <child link="${prefix}_caster"/>
      <origin xyz="${x} 0 ${caster_radius + 0.001}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_caster">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="cleaner_grey"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_sphere>
    </link>

    <gazebo reference="${prefix}_caster">
      <material>Gazebo/Grey</material>
      <mu1>0.001</mu1>
      <mu2>0.001</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster prefix="front" x="${caster_x_offset}"/>
  <xacro:caster prefix="rear"  x="${-caster_x_offset}"/>

  <gazebo reference="chassis">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ===================== Sensors ===================== -->
  <xacro:include filename="$(find floor_cleaner)/urdf/lidar.xacro"/>

  <!-- ===================== Simulation-only plugins ===================== -->
  <xacro:if value="$(arg use_sim)">
    <xacro:include filename="$(find floor_cleaner)/urdf/gazebo_control.xacro"/>
  </xacro:if>

</robot>
