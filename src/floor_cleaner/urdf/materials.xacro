<?xml version="1.0"?>
<!-- Colours used by RViz2. (Gazebo uses the <gazebo reference> colours
     defined in floor_cleaner.urdf.xacro instead.) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="cleaner_white">
    <color rgba="0.92 0.92 0.92 1.0"/>
  </material>

  <material name="cleaner_blue">
    <color rgba="0.15 0.35 0.75 1.0"/>
  </material>

  <material name="cleaner_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <material name="cleaner_grey">
    <color rgba="0.45 0.45 0.45 1.0"/>
  </material>

  <material name="cleaner_orange">
    <color rgba="1.0 0.45 0.05 1.0"/>
  </material>

</robot>
