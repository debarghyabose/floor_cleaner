<?xml version="1.0"?>
<!-- Standard inertia formulas for simple shapes.
     Gazebo needs a mass + inertia on every link that moves,
     otherwise the physics engine ignores or explodes the link. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Solid box: x = length, y = width, z = height -->
  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (y*y + z*z) / 12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass * (x*x + z*z) / 12.0}" iyz="0.0"
               izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid cylinder whose axis is the link's local Z axis -->
  <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (3*radius*radius + length*length) / 12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass * (3*radius*radius + length*length) / 12.0}" iyz="0.0"
               izz="${mass * radius * radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid sphere -->
  <xacro:macro name="inertial_sphere" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${2.0/5.0 * mass * radius * radius}" ixy="0.0" ixz="0.0"
               iyy="${2.0/5.0 * mass * radius * radius}" iyz="0.0"
               izz="${2.0/5.0 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

</robot>
