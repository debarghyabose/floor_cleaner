<?xml version="1.0"?>
<!--
  floor_cleaner_world.world  -  small apartment for the floor-cleaning robot.
  Everything is defined inline (no model:// includes), so Gazebo never tries
  to download models from the internet and starts fast even offline.

  Top view (x to the right, y up). Interior is 10 m x 8 m, walls are 1 m tall.
  The robot spawns at (0, 0) in the HALL, facing +x (east).

   y=4  +=========================+=========================+
        |                         |                         |
        |        ROOM 1           |         ROOM 2   [bed]  |
        |        [table]          |   o pillar              |
   y=1.5+=====+  door  +==========+==========+  door  +=====+
        |                                                   |
        |   [sofa]            HALL      R(0,0) >    (table) |
        |                                                   |
  y=-1.5+=====+  door  +========+=============+  door  +====+
        |                       |                           |
        |  [cabinet]  ROOM 3    |    [desk]   ROOM 4  (pot) |
        |                       |                           |
   y=-4 +=======================+===========================+
      x=-5                    x=-1                          x=5
-->
<sdf version="1.6">
  <world name="floor_cleaner_world">

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -10.5 11 0 0.82 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material>
        </visual>
      </link>
    </model>

    <model name="apartment_walls">
      <static>true</static>
      <link name="walls_link">
        <collision name='outer_north_collision'><pose>0.000 4.075 0.500 0 0 0</pose><geometry><box><size>10.300 0.150 1.000</size></box></geometry></collision>
        <visual name='outer_north_visual'><pose>0.000 4.075 0.500 0 0 0</pose><geometry><box><size>10.300 0.150 1.000</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name='outer_south_collision'><pose>0.000 -4.075 0.500 0 0 0</pose><geometry><box><size>10.300 0.150 1.000</size></box></geometry></collision>
        <visual name='outer_south_visual'><pose>0.000 -4.075 0.500 0 0 0</pose><geometry><box><size>10.300 0.150 1.000</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name='outer_east_collision'><pose>5.075 0.000 0.500 0 0 0</pose><geometry><box><size>0.150 8.000 1.000</size></box></geometry></collision>
        <visual name='outer_east_visual'><pose>5.075 0.000 0.500 0 0 0</pose><geometry><box><size>0.150 8.000 1.000</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name='outer_west_collision'><pose>-5.075 0.000 0.500 0 0 0</pose><geometry><box><size>0.150 8.000 1.000</size></box></geometry></collision>
        <visual name='outer_west_visual'><pose>-5.075 0.000 0.500 0 0 0</pose><geometry><box><size>0.150 8.000 1.000</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name='north_rooms_wall_a_collision'><pose>-4.100 1.500 0.500 0 0 0</pose><geometry><box><size>1.800 0.150 1.000</size></box></geometry></collision>
        <visual name='north_rooms_wall_a_visual'><pose>-4.100 1.500 0.500 0 0 0</pose><geometry><box><size>1.800 0.150 1.000</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name='north_rooms_wall_b_collision'><pose>0.000 1.500 0.500 0 0 0</pose><geometry><box><size>4.000 0.150 1.000</size></box></geometry></collision>
        <visual name='north_rooms_wall_b_visual'><pose>0.000 1.500 0.500 0 0 0</pose><geometry><box><size>4.000 0.150 1.000</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name='north_rooms_wall_c_collision'><pose>4.100 1.500 0.500 0 0 0</pose><geometry><box><size>1.800 0.150 1.000</size></box></geometry></collision>
        <visual name='north_rooms_wall_c_visual'><pose>4.100 1.500 0.500 0 0 0</pose><geometry><box><size>1.800 0.150 1.000</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name='room1_room2_divider_collision'><pose>0.000 2.788 0.500 0 0 0</pose><geometry><box><size>0.150 2.425 1.000</size></box></geometry></collision>
        <visual name='room1_room2_divider_visual'><pose>0.000 2.788 0.500 0 0 0</pose><geometry><box><size>0.150 2.425 1.000</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name='south_rooms_wall_a_collision'><pose>-4.250 -1.500 0.500 0 0 0</pose><geometry><box><size>1.500 0.150 1.000</size></box></geometry></collision>
        <visual name='south_rooms_wall_a_visual'><pose>-4.250 -1.500 0.500 0 0 0</pose><geometry><box><size>1.500 0.150 1.000</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name='south_rooms_wall_b_collision'><pose>-0.650 -1.500 0.500 0 0 0</pose><geometry><box><size>3.300 0.150 1.000</size></box></geometry></collision>
        <visual name='south_rooms_wall_b_visual'><pose>-0.650 -1.500 0.500 0 0 0</pose><geometry><box><size>3.300 0.150 1.000</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name='south_rooms_wall_c_collision'><pose>3.600 -1.500 0.500 0 0 0</pose><geometry><box><size>2.800 0.150 1.000</size></box></geometry></collision>
        <visual name='south_rooms_wall_c_visual'><pose>3.600 -1.500 0.500 0 0 0</pose><geometry><box><size>2.800 0.150 1.000</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name='room3_room4_divider_collision'><pose>-1.000 -2.788 0.500 0 0 0</pose><geometry><box><size>0.150 2.425 1.000</size></box></geometry></collision>
        <visual name='room3_room4_divider_visual'><pose>-1.000 -2.788 0.500 0 0 0</pose><geometry><box><size>0.150 2.425 1.000</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="furniture">
      <static>true</static>
      <link name="furniture_link">
        <collision name='hall_sofa_collision'><pose>-3.000 0.450 0.225 0 0 0</pose><geometry><box><size>1.200 0.500 0.450</size></box></geometry></collision>
        <visual name='hall_sofa_visual'><pose>-3.000 0.450 0.225 0 0 0</pose><geometry><box><size>1.200 0.500 0.450</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name='room1_table_collision'><pose>-2.500 2.900 0.375 0 0 0</pose><geometry><box><size>1.000 0.600 0.750</size></box></geometry></collision>
        <visual name='room1_table_visual'><pose>-2.500 2.900 0.375 0 0 0</pose><geometry><box><size>1.000 0.600 0.750</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name='room2_bed_collision'><pose>3.800 3.200 0.250 0 0 0</pose><geometry><box><size>1.400 1.000 0.500</size></box></geometry></collision>
        <visual name='room2_bed_visual'><pose>3.800 3.200 0.250 0 0 0</pose><geometry><box><size>1.400 1.000 0.500</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name='room3_cabinet_collision'><pose>-3.800 -3.200 0.450 0 0 0</pose><geometry><box><size>0.800 0.800 0.900</size></box></geometry></collision>
        <visual name='room3_cabinet_visual'><pose>-3.800 -3.200 0.450 0 0 0</pose><geometry><box><size>0.800 0.800 0.900</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name='room4_desk_collision'><pose>0.500 -3.300 0.375 0 0 0</pose><geometry><box><size>0.800 0.500 0.750</size></box></geometry></collision>
        <visual name='room4_desk_visual'><pose>0.500 -3.300 0.375 0 0 0</pose><geometry><box><size>0.800 0.500 0.750</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
        <collision name='hall_round_table_collision'><pose>2.600 -0.400 0.350 0 0 0</pose><geometry><cylinder><radius>0.300</radius><length>0.700</length></cylinder></geometry></collision>
        <visual name='hall_round_table_visual'><pose>2.600 -0.400 0.350 0 0 0</pose><geometry><cylinder><radius>0.300</radius><length>0.700</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
        <collision name='room2_pillar_collision'><pose>1.500 2.600 0.500 0 0 0</pose><geometry><cylinder><radius>0.150</radius><length>1.000</length></cylinder></geometry></collision>
        <visual name='room2_pillar_visual'><pose>1.500 2.600 0.500 0 0 0</pose><geometry><cylinder><radius>0.150</radius><length>1.000</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
        <collision name='room4_plant_pot_collision'><pose>3.500 -3.000 0.300 0 0 0</pose><geometry><cylinder><radius>0.350</radius><length>0.600</length></cylinder></geometry></collision>
        <visual name='room4_plant_pot_visual'><pose>3.500 -3.000 0.300 0 0 0</pose><geometry><cylinder><radius>0.350</radius><length>0.600</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
